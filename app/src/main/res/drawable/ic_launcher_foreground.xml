<?xml version="1.0" encoding="utf-8"?>
<!-- A fanned stack of short-video cards (the feed) with a pause sign on the
     front card. Back cards use the dashboard's Instagram / YouTube colors.
     Card size, offset and tilt are chosen so every corner stays inside the
     66dp safe zone (radius 33 around 54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12"
        android:translateX="-8">
        <path
            android:fillColor="#FF3987E5"
            android:pathData="M46,31h16a5,5 0,0 1,5 5v36a5,5 0,0 1,-5 5h-16a5,5 0,0 1,-5 -5v-36a5,5 0,0 1,5 -5z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="12"
        android:translateX="8">
        <path
            android:fillColor="#FFD95926"
            android:pathData="M46,31h16a5,5 0,0 1,5 5v36a5,5 0,0 1,-5 5h-16a5,5 0,0 1,-5 -5v-36a5,5 0,0 1,5 -5z" />
    </group>

    <!-- Front card, with a background-colored ring to separate it from the fan. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF141413"
        android:strokeWidth="2.5"
        android:pathData="M46,31h16a5,5 0,0 1,5 5v36a5,5 0,0 1,-5 5h-16a5,5 0,0 1,-5 -5v-36a5,5 0,0 1,5 -5z" />

    <!-- Pause sign -->
    <path
        android:fillColor="#FF141413"
        android:pathData="M50.75,47a2.25,2.25 0,0 1,2.25 2.25v9.5a2.25,2.25 0,0 1,-4.5 0v-9.5a2.25,2.25 0,0 1,2.25 -2.25zM57.25,47a2.25,2.25 0,0 1,2.25 2.25v9.5a2.25,2.25 0,0 1,-4.5 0v-9.5a2.25,2.25 0,0 1,2.25 -2.25z" />
</vector>
