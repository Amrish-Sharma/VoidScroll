<?xml version="1.0" encoding="utf-8"?>
<!-- One app's row in the dashboard's per-day breakdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/appDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_series_dot" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/dash_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/appValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/dash_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/appShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:max="100"
        app:trackColor="@color/dash_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"
        app:indicatorTrackGapSize="0dp"
        app:trackStopIndicatorSize="0dp" />
</LinearLayout>
